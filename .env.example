# ---------------------------------------------------------------------------
# Database. This is the single place the connection is configured: every setup
# script, ecosystem.config.js (pm2) and docker-compose.yml read these.
#
# CHANGE DB_PASSWORD before any deployment that is reachable by anyone else.
# mapsr/mapsr is a development default, nothing more.
#
# Special characters are fine: the assembled DATABASE_URL percent-encodes the
# user and password. If a value contains $ ` \ or " put single quotes around
# it here, because the shell scripts source this file.
# ---------------------------------------------------------------------------
DB_NAME=mapsr
DB_USER=mapsr
DB_PASSWORD=mapsr
DB_HOST=127.0.0.1
# 5432 for a native PostgreSQL install (scripts/setup_postgres_native.sh).
# 5433 if Postgres is the container from docker-compose.yml.
DB_PORT=5432

# Only set DATABASE_URL to point at a database whose connection string does not
# decompose into the parts above — an existing organisation server, say. When
# set, it overrides all five DB_* values everywhere.
# DATABASE_URL=postgresql://user:pass@db.internal:5432/tcga

OSRM_BASE=http://127.0.0.1:5000
OSRM_SLEEP=0

# CPU architecture for the OSRM image. Read by BOTH docker-compose.yml (the
# running container) and scripts/setup_osrm.sh (the graph build), so declaring
# it here is enough for the whole stack. Defaults to linux/arm64 because the
# development machines are Apple Silicon. Set this on an Intel/AMD server, or
# OSRM runs under emulation, takes minutes to load the road graph and never
# passes its healthcheck.
# OSRM_PLATFORM=linux/amd64

# Path prefix the API is published under. Empty (the default) means the page
# and its API share an origin and requests go to /api/... unchanged. Set this
# when the edge routes by path — with /bkd the browser calls /bkd/api/... and
# nginx strips the prefix before Flask sees it. Same origin either way, so no
# CORS configuration is involved.
# API_BASE_PATH=/bkd

# Where each container publishes on the host. db and backend default to
# loopback: Docker writes its own iptables rules and does not respect ufw, so a
# bare "5433:5432" would put Postgres on the public internet without ufw ever
# showing it open. The frontend defaults to owning port 80 — if this VM already
# runs its own nginx for the domain, move it and let that nginx forward here.
# FRONTEND_PUBLISH=127.0.0.1:8080
# DB_PUBLISH=127.0.0.1:5433
# BACKEND_PUBLISH=127.0.0.1:5050
# OSRM_PUBLISH=127.0.0.1:5000

# Only for the pm2 deployment (gunicorn on the host, nginx serving
# /var/www/html): the backend then reaches the containers over loopback, so the
# defaults above already match. See README > Running the backend under pm2.
