DATABASE_URL=postgresql://mapsr:mapsr@localhost:5433/mapsr
OSRM_BASE=http://127.0.0.1:5000
OSRM_SLEEP=0

# CPU architecture for the OSRM image. Read by BOTH docker-compose.yml (the
# running container) and scripts/setup_osrm.sh (the graph build), so declaring
# it here is enough for the whole stack. Defaults to linux/arm64 because the
# development machines are Apple Silicon. Set this on an Intel/AMD server, or
# OSRM runs under emulation, takes minutes to load the road graph and never
# passes its healthcheck.
# OSRM_PLATFORM=linux/amd64

# Path prefix the API is published under. Empty (the default) means the page
# and its API share an origin and requests go to /api/... unchanged. Set this
# when the edge routes by path — with /bkd the browser calls /bkd/api/... and
# nginx strips the prefix before Flask sees it. Same origin either way, so no
# CORS configuration is involved.
# API_BASE_PATH=/bkd
