DATABASE_URL=postgresql://mapsr:mapsr@localhost:5433/mapsr
OSRM_BASE=http://127.0.0.1:5000
OSRM_SLEEP=0

# CPU architecture for the OSRM image in docker-compose.yml. Defaults to
# linux/arm64 (Apple Silicon). Set this on an Intel/AMD server, or OSRM will
# run under emulation and take minutes to load the road graph.
# OSRM_PLATFORM=linux/amd64
